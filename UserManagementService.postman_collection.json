    {
      "name": "User Authentication",
      "description": "Endpoints for user registration, login, and social authentication.",
      "item": [
        {
          "name": "Register User with Email",
          "request": {
            "method": "POST",
            "description": "Register user with email",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"passenger\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api","auth","register"] }
          }
        },
        {
          "name": "Log In User with Email and Password",
          "request": {
            "method": "POST",
            "description": "Login with email and password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api","auth","login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const data = pm.response.json();",
                  "  if (data && data.token) pm.collectionVariables.set('token', data.token);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Register User with Phone Number",
          "request": {
            "method": "POST",
            "description": "Register user with phone",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"12025550123\",\n  \"password\": \"password123\",\n  \"role\": \"driver\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register-phone", "host": ["{{baseUrl}}"], "path": ["api","auth","register-phone"] }
          }
        },
        {
          "name": "Log In User with Phone Number and Password",
          "request": {
            "method": "POST",
            "description": "Login with phone and password",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"12025550123\",\n  \"password\": \"password123\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login-phone", "host": ["{{baseUrl}}"], "path": ["api","auth","login-phone"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const data = pm.response.json();",
                  "  if (data && data.token) pm.collectionVariables.set('token', data.token);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
        },
        {
          "name": "Social Login (Creates or Logs in User)",
          "request": {
            "method": "POST",
            "description": "Social login (creates or logs in user)",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"provider\": \"google\",\n  \"externalId\": \"ext-123\",\n  \"email\": \"social@example.com\",\n  \"role\": \"passenger\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/social", "host": ["{{baseUrl}}"], "path": ["api","auth","social"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "try {",
                  "  const data = pm.response.json();",
                  "  if (data && data.token) pm.collectionVariables.set('token', data.token);",
                  "} catch (e) {}"
                ]
              }
            }
          ]
