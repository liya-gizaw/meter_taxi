    {
      "name": "User Settings (Self)",
      "description": "Endpoints for authenticated users to manage their own account, profile, and status.",
      "item": [
        {
          "name": "Get Current Authenticated User's Details",
          "request": {
            "method": "GET",
            "description": "Get current user",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] }
          }
        },
        {
          "name": "Update Current Authenticated User's Information",
          "request": {
            "method": "PUT",
            "description": "Update current user",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"new@example.com\",\n  \"phone\": \"12025550123\",\n  \"password\": \"newpass123\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] }
          }
        },
        {
          "name": "Delete Current Authenticated User",
          "request": {
            "method": "DELETE",
            "description": "Delete current user",
            "header": [ { "key": "Authorization", "value": "Bearer {{token}}" } ],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api","auth","me"] }
          }
        },
        {
          "name": "Get Current User's Profile",
          "request": {
            "method": "GET",
            "description": "Get current profile",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{baseUrl}}/api/profiles/me", "host": ["{{baseUrl}}"], "path": ["api","profiles","me"] }
          }
        },
        {
          "name": "Update Current User's Profile",
          "request": {
            "method": "PUT",
            "description": "Update current profile",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"John\",\n  \"last_name\": \"Doe\",\n  \"gender\": \"male\",\n  \"dob\": \"1990-01-01\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/profiles", "host": ["{{baseUrl}}"], "path": ["api","profiles"] }
          }
        },
        {
          "name": "Set Current User's Availability Status",
          "request": {
            "method": "PUT",
            "description": "Set current user availability",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"availability\": \"online\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/users/me/availability", "host": ["{{baseUrl}}"], "path": ["api","users","me","availability"] }
          }
        }
      ]
    },
    {
      "name": "User Documents (Self)",
      "description": "Endpoints for authenticated users to manage their own documents.",
      "item": [
        {
          "name": "Upload a User Document",
          "request": {
            "method": "POST",
            "description": "Upload document",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [] },
                { "key": "type", "type": "text", "value": "driver_license" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/documents/upload", "host": ["{{baseUrl}}"], "path": ["api","documents","upload"] }
